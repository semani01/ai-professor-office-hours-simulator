# Environment Variables — AI Professor Office Hours Simulator
# Copy this file to .env and fill in your actual values
# Never commit .env to the repository

# Claude API (chat layer)
# Get from: https://console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI API (embeddings layer — text-embedding-3-small)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Supabase (vector database + interaction logs)
# Get from: https://supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server port
PORT=3001
